# Safe local default: no external model call is required.
CAMEL_DECISION_ENABLED=false
CAMEL_DECISION_ALLOW_RULE_FALLBACK=true
CAMEL_DECISION_STRICT=false

# Optional model-backed decision configuration.
# CAMEL_MODEL_PLATFORM=OPENAI
# CAMEL_DECISION_MODEL=GPT_4O_MINI
# CAMEL_MODEL_URL=
# CAMEL_API_KEY=
# CAMEL_DECISION_TIMEOUT_SECONDS=180
# CAMEL_DECISION_MAX_RETRIES=1

# Never commit real credentials. Keep them in a local .env or secret manager.
