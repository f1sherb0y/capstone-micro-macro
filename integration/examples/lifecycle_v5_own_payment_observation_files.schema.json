{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Original Owner payment observation files",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "payments"
  ],
  "properties": {
    "schema_version": {
      "const": "lifecycle-v5-own-payment-observation-files.v1"
    },
    "payments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "owner_result",
          "issued_reception",
          "settlement"
        ],
        "properties": {
          "owner_result": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "issued_reception": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "settlement": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    }
  }
}
