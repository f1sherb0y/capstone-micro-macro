{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "V7 existing uncertain Bank execution query recovery input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scenario_id",
    "run_id",
    "source_mode",
    "original_execution",
    "recovery"
  ],
  "properties": {
    "schema_version": {
      "const": "lifecycle-v7-bank-recovery-input.v1"
    },
    "scenario_id": {
      "const": "V7"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "source_mode": {
      "const": "formal"
    },
    "original_execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result_path",
        "result_file_sha256",
        "identity",
        "record_sha256",
        "result_sha256",
        "reading_sha256"
      ],
      "properties": {
        "result_path": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "Original formal Bank A07 execute result.json, absolute or relative to this input file."
        },
        "result_file_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "run_id",
            "organization_id",
            "role",
            "action_id",
            "request_id",
            "purpose",
            "input_sha256",
            "context_sha256",
            "versions"
          ],
          "properties": {
            "run_id": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "organization_id": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "role": {
              "const": "Bank"
            },
            "action_id": {
              "const": "BANK-A07"
            },
            "request_id": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "purpose": {
              "const": "action"
            },
            "input_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "context_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "versions": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "client",
                "skill",
                "prompt",
                "contract",
                "method",
                "model",
                "strategy"
              ],
              "properties": {
                "client": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "skill": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "prompt": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "contract": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "method": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "model": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "strategy": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              }
            }
          }
        },
        "record_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "result_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "reading_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "factory",
        "settings",
        "journal_path",
        "host_configuration_sha256",
        "task_sha256",
        "expected_outcome"
      ],
      "properties": {
        "factory": {
          "type": "string",
          "pattern": "^[^:]+:[^:]+$",
          "description": "Application factory returns BankRecoverySources reopening the original host and journal without submitting or recreating the original task."
        },
        "settings": {
          "type": "object"
        },
        "journal_path": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "Existing original TaskStore journal path, absolute or relative to this input file."
        },
        "host_configuration_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "task_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Digest of exact current original waiting_receipt/receipt_unknown task row."
        },
        "expected_outcome": {
          "enum": [
            "unknown",
            "accepted",
            "rejected"
          ]
        }
      }
    }
  }
}
