{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "V3 original Architect A07 publication to current Government A02 procedural intake",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scenario_id",
    "run_id",
    "government_organization_id",
    "source_mode",
    "architect_publication",
    "request",
    "configuration"
  ],
  "properties": {
    "schema_version": {
      "const": "lifecycle-v3-architect-intake-input.v1"
    },
    "scenario_id": {
      "const": "V3"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "source_mode": {
      "const": "formal"
    },
    "assembly_sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["government_input"],
      "description": "Original Government request/configuration retained by assembly and frozen before and after execution; omitted only for legacy inline inputs.",
      "properties": {
        "government_input": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "file_sha256"],
          "properties": {
            "path": {"type": "string", "minLength": 1, "pattern": "\\S"},
            "file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        }
      }
    },
    "request": {
      "type": "object",
      "description": "Current formal GOV-A02 RoleContractInvocation; original scope/authority/submission independently supplied. Default plan performs no host or model call."
    },
    "configuration": {
      "type": "object",
      "description": "Government RoleContractHostConfiguration with architect_material_inputs selecting original A07 task, publication receipt SHA and ArchitectDeliverableReceipt ref. Source factory supplies independent current receiver/authority/content validation."
    },
    "government_organization_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "architect_publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result_path",
        "result_file_sha256",
        "identity",
        "record_sha256",
        "result_sha256",
        "reading_sha256",
        "publication_path",
        "publication_file_sha256",
        "publication_receipt_sha256",
        "receipt_ref"
      ],
      "properties": {
        "result_path": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "Original role-contract Architect A07 result.json, absolute or relative to this input file."
        },
        "result_file_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "run_id",
            "organization_id",
            "role",
            "action_id",
            "request_id",
            "purpose",
            "input_sha256",
            "context_sha256",
            "versions"
          ],
          "properties": {
            "run_id": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "organization_id": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "role": {
              "const": "Architect"
            },
            "action_id": {
              "const": "ARCHITECT-A07"
            },
            "request_id": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "purpose": {
              "const": "action"
            },
            "input_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "context_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "versions": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "client",
                "skill",
                "prompt",
                "contract",
                "method",
                "model",
                "strategy"
              ],
              "properties": {
                "client": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "skill": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "prompt": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "contract": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "method": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "model": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "strategy": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              }
            }
          }
        },
        "record_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "result_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "reading_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "publication_path": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "Original architect-deliverable-saved-receipt.v1 envelope; not a generated approval."
        },
        "publication_file_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "publication_receipt_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "receipt_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id",
            "version"
          ],
          "properties": {
            "kind": {
              "const": "ArchitectDeliverableReceipt"
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
