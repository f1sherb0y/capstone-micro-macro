{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "V3 original A07 review-task registration to independently authorized A08 reviewer",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scenario_id",
    "run_id",
    "reviewer_organization_id",
    "source_mode",
    "review_task",
    "request",
    "configuration"
  ],
  "properties": {
    "schema_version": {
      "const": "lifecycle-v3-review-task-input.v1"
    },
    "scenario_id": {
      "const": "V3"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "source_mode": {
      "const": "formal"
    },
    "assembly_sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer_input", "registration"],
      "description": "Original reviewer input and task-registration projections retained and frozen by the assembler. Their presence also pins the registration actually consumed by execution.",
      "properties": {
        "reviewer_input": {"$ref": "#/$defs/assembly_source"},
        "registration": {"$ref": "#/$defs/assembly_source"}
      }
    },
    "request": {
      "type": "object",
      "description": "Distinct current formal Architect A08 reviewer invocation, with exact target version, delegated reviewer authority, independent checks and explicit actual review-task registration. Completion can only be review."
    },
    "configuration": {
      "type": "object",
      "description": "Architect RoleContractHostConfiguration with received_review_task_inputs selecting exactly review_task.selection. Application supplies original A07 history/submission, actual intake registration and independent current/history/receipt validators."
    },
    "reviewer_organization_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "review_task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result_path",
        "result_file_sha256",
        "identity",
        "record_sha256",
        "result_sha256",
        "reading_sha256",
        "selection"
      ],
      "properties": {
        "result_path": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "Original formal role-contract Architect A07 request_review result.json, absolute or relative to this input file."
        },
        "result_file_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "run_id",
            "organization_id",
            "role",
            "action_id",
            "request_id",
            "purpose",
            "input_sha256",
            "context_sha256",
            "versions"
          ],
          "properties": {
            "run_id": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "organization_id": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "role": {
              "const": "Architect"
            },
            "action_id": {
              "const": "ARCHITECT-A07"
            },
            "request_id": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "purpose": {
              "const": "action"
            },
            "input_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "context_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "versions": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "client",
                "skill",
                "prompt",
                "contract",
                "method",
                "model",
                "strategy"
              ],
              "properties": {
                "client": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "skill": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "prompt": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "contract": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "method": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "model": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "strategy": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              }
            }
          }
        },
        "record_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "result_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "reading_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "selection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_task_sha256",
            "registration_ref",
            "native_evidence_ref",
            "native_source_sha256",
            "relation_evidence_refs"
          ],
          "properties": {
            "source_task_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "native_evidence_ref": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "id",
                "version"
              ],
              "properties": {
                "kind": {
                  "const": "Evidence"
                },
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "version": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "native_source_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "relation_evidence_refs": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "id",
                  "version"
                ],
                "properties": {
                  "kind": {
                    "const": "Evidence"
                  },
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "registration_ref": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "id",
                "version"
              ],
              "properties": {
                "kind": {
                  "const": "ArchitectReviewTaskRegistration"
                },
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "version": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "assembly_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "file_sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
