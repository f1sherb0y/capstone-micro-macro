{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "V4 original Supplier receiving result to current Contractor material input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scenario_id",
    "run_id",
    "contractor_organization_id",
    "source_mode",
    "supplier_receiving",
    "request",
    "configuration"
  ],
  "properties": {
    "schema_version": {
      "const": "lifecycle-v4-contractor-material-input.v1"
    },
    "scenario_id": {
      "const": "V4"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "source_mode": {
      "enum": [
        "fixture",
        "formal"
      ]
    },
    "assembly_sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractor_input", "material_basis"],
      "description": "Original Contractor input and ordered actual material-basis projections retained and frozen by assembly; execution must consume the same selected projections.",
      "properties": {
        "contractor_input": {"$ref": "#/$defs/assembly_source"},
        "material_basis": {"$ref": "#/$defs/assembly_source"}
      }
    },
    "request": {
      "type": "object",
      "description": "Explicit current Contractor A07 RoleContractInvocation. fixture requires offline_fixture, formal requires llm; no receipt, stock, use release or work is inferred."
    },
    "configuration": {
      "type": "object",
      "description": "Contractor RoleContractHostConfiguration with received_material_inputs selecting the original Supplier task and material_basis_refs. Existing source factory provides independent actual or explicitly synthetic inventory mapping and receipt/inspection/use-release validation."
    },
    "contractor_organization_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "supplier_receiving": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result_path",
        "result_file_sha256",
        "identity",
        "record_sha256",
        "result_sha256",
        "reading_sha256",
        "material_basis_refs"
      ],
      "properties": {
        "result_path": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "Original role-contract Supplier A09 result.json, absolute or relative to this input file."
        },
        "result_file_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "run_id",
            "organization_id",
            "role",
            "action_id",
            "request_id",
            "purpose",
            "input_sha256",
            "context_sha256",
            "versions"
          ],
          "properties": {
            "run_id": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "organization_id": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "role": {
              "const": "Supplier"
            },
            "action_id": {
              "const": "SUPPLIER-A09"
            },
            "request_id": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "purpose": {
              "const": "action"
            },
            "input_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "context_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "versions": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "client",
                "skill",
                "prompt",
                "contract",
                "method",
                "model",
                "strategy"
              ],
              "properties": {
                "client": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "skill": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "prompt": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "contract": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "method": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "model": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "strategy": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              }
            }
          }
        },
        "record_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "result_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "reading_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "material_basis_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "id",
              "version"
            ],
            "properties": {
              "kind": {
                "const": "ReceivedMaterialBasis"
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "version": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  {
                    "type": "integer"
                  }
                ]
              }
            }
          },
          "description": "Explicit current independently validated Contractor material basis versions; original Supplier result alone creates no usable inventory."
        }
      }
    }
  },
  "$defs": {
    "assembly_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "file_sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
