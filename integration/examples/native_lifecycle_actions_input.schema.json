    "FinalAccountOwnerReception": {
      "additionalProperties": false,
      "description": "Owner handles an actually received QS question through original A06.",
      "properties": {
        "message_tick": {
          "minimum": 1,
          "title": "Message Tick",
          "type": "integer"
        },
        "evidence_ref": {
          "$ref": "#/$defs/EvidenceRef"
        },
        "decision_ref": {
          "$ref": "#/$defs/PaymentAuthorizationRef"
        }
      },
      "required": [
        "message_tick",
        "evidence_ref",
        "decision_ref"
      ],
      "title": "FinalAccountOwnerReception",
      "type": "object"
    },
    "FinalAccountPositionReception": {
      "additionalProperties": false,
      "description": "Contractor consumes an actual Owner communication in its own A11 note.",
      "properties": {
        "message_tick": {
          "minimum": 1,
          "title": "Message Tick",
          "type": "integer"
        },
        "evidence_ref": {
          "$ref": "#/$defs/EvidenceRef"
        },
        "profile_ref": {
          "$ref": "#/$defs/HandoverProfileRef"
        }
      },
      "required": [
        "message_tick",
        "evidence_ref",
        "profile_ref"
      ],
      "title": "FinalAccountPositionReception",
      "type": "object"
    },
    "FinalAccountQuestionReception": {
      "additionalProperties": false,
      "description": "Explicit QS policy: append received Owner communication to one question.",
      "properties": {
        "message_tick": {
          "minimum": 1,
          "title": "Message Tick",
          "type": "integer"
        },
        "message_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Message Index"
        },
        "evidence_ref": {
          "$ref": "#/$defs/EvidenceRef"
        },
        "question_ref": {
          "$ref": "#/$defs/EvidenceTargetRef"
        },
        "publish_question_text": {
          "default": false,
          "title": "Publish Question Text",
          "type": "boolean"
        },
        "contractor_message_tick": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Contractor Message Tick"
        },
        "contractor_evidence_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/EvidenceRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "contractor_message_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Contractor Message Index"
        }
      },
      "required": [
        "message_tick",
        "evidence_ref",
        "question_ref"
      ],
      "title": "FinalAccountQuestionReception",
      "type": "object"
    },
