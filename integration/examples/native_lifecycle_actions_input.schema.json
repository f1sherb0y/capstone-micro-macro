{
  "$defs": {
    "ActionContext": {
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Run Id",
          "type": "string"
        },
        "actor_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Actor Id",
          "type": "string"
        },
        "function_ref": {
          "$ref": "#/$defs/FunctionAssignmentRef"
        },
        "authorization_refs": {
          "items": {
            "$ref": "#/$defs/AuthorizationRef"
          },
          "title": "Authorization Refs",
          "type": "array"
        },
        "operation_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Operation Id",
          "type": "string"
        },
        "contract_ref": {
          "$ref": "#/$defs/ActionContractRef"
        },
        "task_ref": {
          "$ref": "#/$defs/DecisionTaskRef"
        },
        "scope": {
          "discriminator": {
            "mapping": {
              "assessment_case": "#/$defs/AssessmentScope",
              "organization": "#/$defs/OrganizationScope",
              "project": "#/$defs/ProjectScope"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/OrganizationScope"
            },
            {
              "$ref": "#/$defs/AssessmentScope"
            },
            {
              "$ref": "#/$defs/ProjectScope"
            }
          ],
          "title": "Scope"
        },
        "business_time": {
          "$ref": "#/$defs/TimePoint"
        },
        "read_token": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Read Token",
          "type": "string"
        },
        "visible_refs": {
          "items": {
            "$ref": "#/$defs/Reference"
          },
          "title": "Visible Refs",
          "type": "array"
        },
        "candidate_set_ref": {
          "$ref": "#/$defs/CandidateSetRef"
        },
        "execution_mode": {
          "enum": [
            "llm",
            "rule",
            "routine",
            "offline_fixture"
          ],
          "title": "Execution Mode",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "actor_id",
        "function_ref",
        "authorization_refs",
        "operation_id",
        "contract_ref",
        "task_ref",
        "scope",
        "business_time",
        "read_token",
        "visible_refs",
        "candidate_set_ref",
        "execution_mode"
      ],
      "title": "ActionContext",
      "type": "object"
    },
    "ActionContractRef": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "ActionContract",
          "title": "Kind",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Id",
          "type": "string"
