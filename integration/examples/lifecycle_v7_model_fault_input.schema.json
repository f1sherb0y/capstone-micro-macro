{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "V7 complete authorized synthetic action configuration for one local model fault",
  "description": "Requires application-supplied complete original facts, authorities and independently validated distinct alternatives. Defaults to plan only; this schema is not an executed or passing business case.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scenario_id",
    "origin",
    "request",
    "identity",
    "client_settings",
    "model_configuration",
    "options",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "const": "lifecycle-v7-model-fault-input.v1"
    },
    "scenario_id": {
      "const": "V7"
    },
    "origin": {
      "const": "synthetic"
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "context",
        "action_input",
        "execution_path"
      ],
      "properties": {
        "schema_version": {
          "const": "role-contract-invocation.v1"
        },
        "context": {
          "type": "object",
          "required": [
            "run_id",
            "actor_id",
            "function_ref",
            "authorization_refs",
            "operation_id",
            "contract_ref",
            "task_ref",
            "scope",
            "business_time",
            "read_token",
            "visible_refs",
            "candidate_set_ref",
            "execution_mode"
          ],
          "properties": {
            "execution_mode": {
              "const": "offline_fixture"
            }
          }
        },
        "action_input": {
          "type": "object"
        },
        "execution_path": {
          "const": "single_agent"
        }
      }
    },
    "identity": {
      "type": "object",
      "required": [
        "run_id",
        "organization_id",
        "role",
        "action_id",
        "request_id",
        "purpose",
        "input_sha256",
        "context_sha256",
        "versions"
      ],
      "properties": {
        "purpose": {
          "const": "action"
        },
        "versions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "client",
            "skill",
            "prompt",
            "contract",
            "method",
            "model",
            "strategy"
          ],
          "properties": {
            "client": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "skill": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "prompt": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "contract": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "method": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "model": {
              "const": "synthetic-local-model-fault.v1"
            },
            "strategy": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        }
      }
    },
    "client_settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "origin",
        "case_id",
        "fault",
        "response"
      ],
      "properties": {
        "schema_version": {
          "const": "scripted-model-fault-settings.v1"
        },
        "origin": {
          "const": "synthetic"
        },
        "case_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "fault": {
          "enum": [
            "timeout",
            "invalid_json"
          ]
        },
        "response": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2048
        }
      }
    },
    "model_configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host_id",
        "budget_id",
        "max_calls",
        "action_ids",
        "max_options",
        "max_prompt_chars",
        "max_response_chars"
      ],
      "properties": {
        "host_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "budget_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "max_calls": {
          "const": 1
        },
        "action_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "max_options": {
          "type": "integer",
          "minimum": 2
        },
        "max_prompt_chars": {
          "type": "integer",
          "minimum": 1
        },
        "max_response_chars": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "options": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "option_id",
          "action_input"
        ],
        "properties": {
          "option_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "action_input": {
            "type": "object"
          }
        }
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "factory",
        "settings",
        "journal_path"
      ],
      "properties": {
        "factory": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^:]+:[^:]+$"
        },
        "settings": {
          "type": "object"
        },
        "journal_path": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    }
  }
}
