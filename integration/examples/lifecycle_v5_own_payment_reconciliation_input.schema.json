{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Actual original Owner payment reconciliation input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scenario_id",
    "run_id",
    "owner_organization_id",
    "request",
    "configuration",
    "payments",
    "assembly_sources"
  ],
  "properties": {
    "schema_version": {
      "const": "lifecycle-v5-own-payment-reconciliation-input.v1"
    },
    "scenario_id": {
      "const": "V5"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "owner_organization_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "request": {
      "type": "object",
      "description": "Formal current Owner A06 RoleContractInvocation, with actual pending executions."
    },
    "configuration": {
      "type": "object",
      "description": "Original Owner configuration with payment_execution_inputs selecting complete original pay/repay groups."
    },
    "payments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "owner_result",
          "issued_reception",
          "settlement"
        ],
        "properties": {
          "owner_result": {
            "$ref": "#/$defs/sourceFile"
          },
          "issued_reception": {
            "$ref": "#/$defs/sourceFile"
          },
          "settlement": {
            "anyOf": [
              {
                "$ref": "#/$defs/sourceFile"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "assembly_sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner_input",
        "payment_sources"
      ],
      "properties": {
        "owner_input": {
          "$ref": "#/$defs/sourceFile"
        },
        "payment_sources": {
          "$ref": "#/$defs/sourceFile"
        }
      }
    }
  },
  "$defs": {
    "sourceFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "file_sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "file_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
